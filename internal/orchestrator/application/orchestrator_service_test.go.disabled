package application

import (
	"context"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/mock"
	"github.com/stretchr/testify/require"

	"neuromesh/internal/logging"
	domain "neuromesh/internal/planning/domain"
)

// MockAIPlanningEngine for testing the new planning interface
type MockAIPlanningEngine struct {
	mock.Mock
}

func (m *MockAIPlanningEngine) CreateExecutionPlan(ctx context.Context, userInput, userID, agentContext, requestID string) (*domain.PlanningResult, error) {
	args := m.Called(ctx, userInput, userID, agentContext, requestID)
	return args.Get(0).(*domain.PlanningResult), args.Error(1)
}

// MockGraphExplorer for testing graph exploration
type MockGraphExplorer struct {
	mock.Mock
}

func (m *MockGraphExplorer) GetAgentContext(ctx context.Context) (string, error) {
	args := m.Called(ctx)
	return args.String(0), args.Error(1)
}

// MockAIExecutionEngine for testing execution engine
type MockAIExecutionEngine struct {
	mock.Mock
}

func (m *MockAIExecutionEngine) ExecuteWithAgents(ctx context.Context, executionPlan, userInput, userID, agentContext string) (string, error) {
	args := m.Called(ctx, executionPlan, userInput, userID, agentContext)
	return args.String(0), args.Error(1)
}

func TestOrchestratorService_NewPlanningApproach(t *testing.T) {
	ctx := context.Background()
	logger := logging.NewNoOpLogger()

	t.Run("should process execute planning result successfully", func(t *testing.T) {
		// Arrange: Mock components for new planning approach
		mockPlanningEngine := &MockAIPlanningEngine{}
		mockGraphExplorer := &MockGraphExplorer{}
		mockExecutionEngine := &MockAIExecutionEngine{}

		// Set up mock expectations
		mockGraphExplorer.On("GetAgentContext", ctx).Return("Available agents: text-processor, image-analyzer", nil)

		planningResult := &domain.PlanningResult{
			ID:              "planning-001",
			Type:            domain.PlanningTypeExecute,
			ExecutionPlanID: "exec-plan-001",
			RequiredAgents:  []string{"text-processor"},
			Intent:          "analyze_text",
			Category:        "text_analysis",
			Confidence:      95,
			Reasoning:       "User wants to analyze text content",
		}

		mockPlanningEngine.On("CreateExecutionPlan", ctx, "Analyze this document", "user-123", "Available agents: text-processor, image-analyzer", "msg-001").Return(planningResult, nil)
		mockExecutionEngine.On("ExecuteWithAgents", ctx, "exec-plan-001", "Analyze this document", "user-123", "Available agents: text-processor, image-analyzer").Return("Analysis completed: Document contains 1000 words", nil)

		// Create orchestrator with new unified planning approach
		orchestrator := NewOrchestratorService(
			mockPlanningEngine,
			mockGraphExplorer,
			mockExecutionEngine,
			nil, // conversation service
			nil, // executionCoordinator - NEW Phase 3 parameter
			nil, // result synthesizer
			nil, // repository
			logger,
		)

		request := &OrchestratorRequest{
			UserInput:      "Analyze this document",
			UserID:         "user-123",
			MessageID:      "msg-001",
			ConversationID: "conv-001",
		}

		// Act: Process request using new planning approach
		result, err := orchestrator.ProcessUserRequest(ctx, request)

		// Assert: Should use new planning approach successfully
		require.NoError(t, err)
		assert.True(t, result.Success)
		assert.NotNil(t, result.PlanningResult)
		assert.Equal(t, "planning-001", result.PlanningResult.ID)
		assert.Equal(t, domain.PlanningTypeExecute, result.PlanningResult.Type)
		assert.Equal(t, "exec-plan-001", result.ExecutionPlanID)
		assert.Equal(t, "Analysis completed: Document contains 1000 words", result.Message)

		// Verify all mocks were called
		mockGraphExplorer.AssertExpectations(t)
		mockPlanningEngine.AssertExpectations(t)
		mockExecutionEngine.AssertExpectations(t)
	})

	t.Run("should handle clarify planning result", func(t *testing.T) {
		// Arrange: Mock components for clarification scenario
		mockPlanningEngine := &MockAIPlanningEngine{}
		mockGraphExplorer := &MockGraphExplorer{}
		mockExecutionEngine := &MockAIExecutionEngine{}

		// Set up mock expectations for clarification
		mockGraphExplorer.On("GetAgentContext", ctx).Return("Available agents: text-processor", nil)

		planningResult := &domain.PlanningResult{
			ID:                    "planning-002",
			Type:                  domain.PlanningTypeClarify,
			ClarificationQuestion: "What type of analysis would you like me to perform on your document?",
			Intent:                "unclear_request",
			Category:              "clarification",
			Confidence:            60,
			Reasoning:             "Request is too vague to determine specific action",
		}

		mockPlanningEngine.On("CreateExecutionPlan", ctx, "Do something", "user-123", "Available agents: text-processor", "msg-002").Return(planningResult, nil)

		// Create orchestrator
		orchestrator := NewOrchestratorService(
			mockPlanningEngine,
			mockGraphExplorer,
			mockExecutionEngine,
			nil, nil, nil,
			logger,
		)

		request := &OrchestratorRequest{
			UserInput: "Do something",
			UserID:    "user-123",
			MessageID: "msg-002",
		}

		// Act
		result, err := orchestrator.ProcessUserRequest(ctx, request)

		// Assert: Should return clarification
		require.NoError(t, err)
		assert.True(t, result.Success)
		assert.NotNil(t, result.PlanningResult)
		assert.Equal(t, domain.PlanningTypeClarify, result.PlanningResult.Type)
		assert.Equal(t, "What type of analysis would you like me to perform on your document?", result.Message)

		// Verify mocks
		mockGraphExplorer.AssertExpectations(t)
		mockPlanningEngine.AssertExpectations(t)
	})

	t.Run("should handle respond directly planning result", func(t *testing.T) {
		// Arrange: Mock components for direct response scenario
		mockPlanningEngine := &MockAIPlanningEngine{}
		mockGraphExplorer := &MockGraphExplorer{}
		mockExecutionEngine := &MockAIExecutionEngine{}

		// Set up mock expectations for direct response
		mockGraphExplorer.On("GetAgentContext", ctx).Return("Available agents: text-processor", nil)

		planningResult := &domain.PlanningResult{
			ID:             "planning-003",
			Type:           domain.PlanningTypeRespondDirectly,
			DirectResponse: "I am NeuroMesh, an AI orchestration platform. I can help you analyze text, process images, and coordinate complex tasks using specialized AI agents.",
			Intent:         "system_inquiry",
			Category:       "meta_query",
			Confidence:     100,
			Reasoning:      "User is asking about system capabilities",
		}

		mockPlanningEngine.On("CreateExecutionPlan", ctx, "What are you?", "user-123", "Available agents: text-processor", "msg-003").Return(planningResult, nil)

		// Create orchestrator
		orchestrator := NewOrchestratorService(
			mockPlanningEngine,
			mockGraphExplorer,
			mockExecutionEngine,
			nil, nil, nil,
			logger,
		)

		request := &OrchestratorRequest{
			UserInput: "What are you?",
			UserID:    "user-123",
			MessageID: "msg-003",
		}

		// Act
		result, err := orchestrator.ProcessUserRequest(ctx, request)

		// Assert: Should return direct response
		require.NoError(t, err)
		assert.True(t, result.Success)
		assert.NotNil(t, result.PlanningResult)
		assert.Equal(t, domain.PlanningTypeRespondDirectly, result.PlanningResult.Type)
		assert.Equal(t, "I am NeuroMesh, an AI orchestration platform. I can help you analyze text, process images, and coordinate complex tasks using specialized AI agents.", result.Message)

		// Verify mocks
		mockGraphExplorer.AssertExpectations(t)
		mockPlanningEngine.AssertExpectations(t)
	})
}
