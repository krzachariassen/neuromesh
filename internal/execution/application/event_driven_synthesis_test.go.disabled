package application

import (
	"context"
	"encoding/json"
	"testing"
	"time"

	"neuromesh/internal/logging"
	"neuromesh/internal/messaging"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// TestEventDrivenSynthesisCoordination tests the event-driven approach where synthesis
// listens for agent.completed events rather than being directly coupled
func TestEventDrivenSynthesisCoordination(t *testing.T) {
	t.Run("agent completion event triggers synthesis coordination", func(t *testing.T) {
		// Setup
		logger := logging.NewNoOpLogger()
		eventRouter := &MockEventRouter{events: make(chan messaging.EventMessage, 10)}
		coordinator := NewEventDrivenSynthesisCoordinator(eventRouter, logger)

		// RED: This should fail as we haven't implemented NewEventDrivenSynthesisCoordinator
		require.NotNil(t, coordinator)
		
		// Start listening for agent completion events
		ctx, cancel := context.WithTimeout(context.Background(), 1*time.Second)
		defer cancel()

		err := coordinator.StartListening(ctx, "synthesis.events", "synthesis-queue", "agent.completed")
		require.NoError(t, err)

		// Simulate agent completion event
		completionEvent := messaging.AgentCompletedEvent{
			PlanID:    "plan-123",
			StepID:    "step-456",
			AgentID:   "agent-789",
			Status:    "success",
			Timestamp: time.Now(),
		}

		// Publish agent completion event
		err = eventRouter.PublishEvent(ctx, "synthesis.events", "agent.completed", completionEvent)
		require.NoError(t, err)

		// Wait for synthesis to be triggered
		time.Sleep(100 * time.Millisecond)

		// Verify synthesis was triggered
		triggered := coordinator.WasSynthesisTriggered("plan-123")
		assert.True(t, triggered, "Synthesis should be triggered for plan-123")
	})

	t.Run("synthesis coordinator ignores non-success agent events", func(t *testing.T) {
		// Setup
		logger := logging.NewNoOpLogger()
		eventRouter := &MockEventRouter{events: make(chan messaging.EventMessage, 10)}
		coordinator := NewEventDrivenSynthesisCoordinator(eventRouter, logger)

		ctx, cancel := context.WithTimeout(context.Background(), 1*time.Second)
		defer cancel()

		err := coordinator.StartListening(ctx, "synthesis.events", "synthesis-queue", "agent.completed")
		require.NoError(t, err)

		// Simulate failed agent completion
		failureEvent := messaging.AgentCompletedEvent{
			PlanID:    "plan-456",
			StepID:    "step-789",
			AgentID:   "agent-abc",
			Status:    "failed",
			Timestamp: time.Now(),
		}

		err = eventRouter.PublishEvent(ctx, "synthesis.events", "agent.completed", failureEvent)
		require.NoError(t, err)

		time.Sleep(100 * time.Millisecond)

		// Verify synthesis was NOT triggered for failed agent
		triggered := coordinator.WasSynthesisTriggered("plan-456")
		assert.False(t, triggered, "Synthesis should not be triggered for failed agent")
	})

	t.Run("multiple agent completions for same plan trigger synthesis once", func(t *testing.T) {
		// Setup
		logger := logging.NewNoOpLogger()
		eventRouter := &MockEventRouter{events: make(chan messaging.EventMessage, 10)}
		coordinator := NewEventDrivenSynthesisCoordinator(eventRouter, logger)

		ctx, cancel := context.WithTimeout(context.Background(), 1*time.Second)
		defer cancel()

		err := coordinator.StartListening(ctx, "synthesis.events", "synthesis-queue", "agent.completed")
		require.NoError(t, err)

		planID := "plan-multi-agent"

		// Simulate multiple agent completions for same plan
		for i := 0; i < 3; i++ {
			completionEvent := messaging.AgentCompletedEvent{
				PlanID:    planID,
				StepID:    "step-" + string(rune('A'+i)),
				AgentID:   "agent-" + string(rune('1'+i)),
				Status:    "success",
				Timestamp: time.Now(),
			}

			err = eventRouter.PublishEvent(ctx, "synthesis.events", "agent.completed", completionEvent)
			require.NoError(t, err)
		}

		time.Sleep(200 * time.Millisecond)

		// Verify synthesis was triggered exactly once
		triggerCount := coordinator.GetSynthesisTriggerCount(planID)
		assert.Equal(t, 1, triggerCount, "Synthesis should be triggered exactly once per plan")
	})
}

// MockEventRouter implements EventRouter for testing
type MockEventRouter struct {
	events     chan messaging.EventMessage
	exchanges  map[string]bool
	bindings   map[string][]string // queue -> routing keys
}

func (m *MockEventRouter) SetupEventExchange(ctx context.Context, exchangeName string) error {
	if m.exchanges == nil {
		m.exchanges = make(map[string]bool)
	}
	m.exchanges[exchangeName] = true
	return nil
}

func (m *MockEventRouter) PublishEvent(ctx context.Context, exchange, routingKey string, event interface{}) error {
	eventData, _ := json.Marshal(event)
	eventMsg := messaging.EventMessage{
		Exchange:      exchange,
		RoutingKey:    routingKey,
		EventType:     routingKey,
		EventData:     json.RawMessage(eventData),
		Timestamp:     time.Now(),
		CorrelationID: "test-correlation",
	}

	select {
	case m.events <- eventMsg:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

func (m *MockEventRouter) SubscribeToEvents(ctx context.Context, exchange, queueName, routingKey string) (<-chan messaging.EventMessage, error) {
	if m.bindings == nil {
		m.bindings = make(map[string][]string)
	}
	m.bindings[queueName] = append(m.bindings[queueName], routingKey)
	
	// Return the mock events channel
	return m.events, nil
}

func (m *MockEventRouter) Close() error {
	if m.events != nil {
		close(m.events)
	}
	return nil
}

// EventDrivenSynthesisCoordinator represents the component we need to implement
type EventDrivenSynthesisCoordinator struct {
	eventRouter       messaging.EventRouter
	logger           logging.Logger
	triggeredPlans   map[string]bool
	triggerCounts    map[string]int
}

// NewEventDrivenSynthesisCoordinator creates a new event-driven synthesis coordinator
// RED: This will fail as it doesn't exist yet
func NewEventDrivenSynthesisCoordinator(eventRouter messaging.EventRouter, logger logging.Logger) *EventDrivenSynthesisCoordinator {
	return &EventDrivenSynthesisCoordinator{
		eventRouter:     eventRouter,
		logger:         logger,
		triggeredPlans: make(map[string]bool),
		triggerCounts:  make(map[string]int),
	}
}

// StartListening starts listening for agent completion events
func (c *EventDrivenSynthesisCoordinator) StartListening(ctx context.Context, exchange, queueName, routingKey string) error {
	// Setup exchange
	err := c.eventRouter.SetupEventExchange(ctx, exchange)
	if err != nil {
		return err
	}

	// Subscribe to events
	eventChan, err := c.eventRouter.SubscribeToEvents(ctx, exchange, queueName, routingKey)
	if err != nil {
		return err
	}

	// Start processing events
	go c.processEvents(ctx, eventChan)
	return nil
}

// processEvents processes incoming agent completion events
func (c *EventDrivenSynthesisCoordinator) processEvents(ctx context.Context, eventChan <-chan messaging.EventMessage) {
	for {
		select {
		case <-ctx.Done():
			return
		case eventMsg, ok := <-eventChan:
			if !ok {
				return
			}

			// Only process agent completion events
			if eventMsg.RoutingKey == "agent.completed" {
				var completionEvent messaging.AgentCompletedEvent
				if err := json.Unmarshal(eventMsg.EventData, &completionEvent); err != nil {
					c.logger.Error("Failed to unmarshal agent completion event", err)
					continue
				}

				// Only trigger synthesis for successful agent completions
				if completionEvent.Status == "success" {
					c.triggerSynthesis(completionEvent.PlanID)
				}
			}
		}
	}
}

// triggerSynthesis triggers synthesis for a plan (only once per plan)
func (c *EventDrivenSynthesisCoordinator) triggerSynthesis(planID string) {
	// Only trigger once per plan
	if c.triggeredPlans[planID] {
		return
	}

	c.triggeredPlans[planID] = true
	c.triggerCounts[planID]++

	c.logger.Info("🔄 Synthesis triggered for plan", "plan_id", planID)
}

// WasSynthesisTriggered checks if synthesis was triggered for a plan
func (c *EventDrivenSynthesisCoordinator) WasSynthesisTriggered(planID string) bool {
	return c.triggeredPlans[planID]
}

// GetSynthesisTriggerCount gets the number of times synthesis was triggered for a plan
func (c *EventDrivenSynthesisCoordinator) GetSynthesisTriggerCount(planID string) int {
	return c.triggerCounts[planID]
}
